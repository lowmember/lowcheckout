{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["ES2024"],
    "module": "esnext",
    "skipLibCheck": true,

    /* Bundler mode — quem builda é o esbuild da api e o vite do web */
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
