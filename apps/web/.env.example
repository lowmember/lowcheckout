# Em dev, `/api` passa pelo proxy do Vite (vite.config.ts) e evita a preflight de
# CORS, que o serverless-offline não responde. Em produção, use a URL absoluta da API.
VITE_API_URL=/api
VITE_PUBLIC_CHECKOUT_URL=http://localhost:5173

# Client ID OAuth do Google (o mesmo GOOGLE_CLIENT_ID da API). Termina sempre em
# `.apps.googleusercontent.com` — se começar com `GOCSPX-`, é o *secret*, não o ID.
VITE_GOOGLE_CLIENT_ID=
