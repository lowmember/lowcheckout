# Serverless Framework v4 exige uma license key (gratuita) para rodar a CLI.
# Gere em https://app.serverless.com -> Settings -> Access Keys
SERVERLESS_ACCESS_KEY=

# Postgres local (docker compose up -d). Em produção, use a connection string
# *pooled* do Neon: postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require
DATABASE_URL=postgresql://lowcheckout:lowcheckout@localhost:5432/lowcheckout

# Conexões por container. Mantenha 1 no Lambda; localmente pode subir.
DATABASE_POOL_MAX=10

LOG_LEVEL=info
# Origens autorizadas no CORS do API Gateway, separadas por vírgula. Obrigatório:
# o `serverless deploy` falha sem isto. São DOIS front-ends: o painel do lojista
# (apps/web, :5173) e a página do comprador (apps/checkout, :5273) — esquecer o
# segundo derruba todo checkout público no navegador.
# Em produção: https://app.lowcheckout.com,https://lowchk.click
CORS_ORIGINS=http://localhost:5173,http://localhost:5273

AWS_REGION=us-east-1

# Sessão da API. JWT_SECRET é obrigatório (mínimo 32 caracteres) — gere um por ambiente:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-only-insecure-secret-change-me-0123456789
JWT_ISSUER=lowcheckout-api
JWT_AUDIENCE=lowcheckout-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# OAuth do Google (RF-AUTH-01). Sem isto, POST /auth/google responde erro explícito.
# Client ID do tipo "Web application" no Google Cloud Console.
GOOGLE_CLIENT_ID=
# Chave AES-256 das credenciais de terceiros (gateway, access token de pixel).
# 32 bytes em hexadecimal — gere uma por ambiente:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=3a7f1c9e5b8d2046a1c3e5f70921436587a9cbed0f2143658790abcdef012345

# Adapter de gateway montado pelo composition root:
#   auto    -> EfiBank real só em prod, dublê no resto (padrão)
#   fake    -> força o dublê (fluxo público completo sem conta no provedor)
#   efibank -> força o real, para exercitar o sandbox do EfiBank
PAYMENT_GATEWAY=auto

# Prazo do PIX em segundos (configuração do produto, não do usuário).
PIX_EXPIRATION_SECONDS=3600

# Bucket S3 das imagens enviadas pelo painel (produto, oferta e seções do
# checkout). O `serverless deploy` cria o bucket; o nome padrão é
# `lowcheckout-api-<stage>-uploads` e só precisa ser preenchido aqui se esse
# nome já estiver em uso (nome de bucket é global no S3).
# Vazio ou apontando para um bucket inexistente: POST /uploads/images responde
# 503 e o painel continua aceitando a URL colada.
S3_UPLOADS_BUCKET=
# CDN ou domínio próprio na frente do bucket (ex.: https://cdn.lowcheckout.com).
# Vazio usa o endpoint do S3.
S3_UPLOADS_PUBLIC_BASE_URL=

# Segredo compartilhado do webhook do gateway (header x-webhook-token ou ?token=).
# Obrigatório em produção; em dev, se vazio, o webhook é aceito sem token.
WEBHOOK_SECRET=dev-webhook-secret
