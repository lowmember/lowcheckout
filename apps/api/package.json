{
  "name": "lowcheckout-api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "serverless offline start",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait && pnpm db:migrate",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "deploy": "serverless deploy",
    "deploy:prod": "serverless deploy --stage prod",
    "package": "serverless package",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "@lowcheckout/contracts": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.10",
    "postgres": "^3.4.9",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/aws-lambda": "^8.10.162",
    "@types/node": "^26.4.0",
    "drizzle-kit": "^0.31.10",
    "serverless": "^4.41.1",
    "serverless-offline": "^14.8.0",
    "typescript": "~7.0.2"
  }
}
